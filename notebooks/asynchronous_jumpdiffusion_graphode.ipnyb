   "source": [
    "# ==============================================================================\n",
    "# CELL 7: PRODUCTION METRICS EVALUATOR & LOOP EXECUTION\n",
    "# ==============================================================================\n",
    "\n",
    "def execute_production_validation_sweep(model, data_loader, cluster_registry):\n",
    "    \"\"\"\n",
    "    Runs an inline evaluation pass across the validation dataset to compute\n",
    "    baseline performance metrics for the Jump-Diffusion architecture.\n",
    "    \"\"\"\n",
    "    model.eval()\n",
    "    criterion = nn.MSELoss()\n",
    "    total_loss, steps_tracked = 0.0, 0\n",
    "    \n",
    "    print(\"\\n[EVAL] Running forward integration trajectories across validation blocks...\")\n",
    "    with torch.no_grad():\n",
    "        for xb, vyb, c_idx_t, _ in tqdm(data_loader, desc=\"Processing Graph Steps\"):\n",
    "            c_idx = int(c_idx_t[0].item())\n",
    "            \n",
    "            # Unpack batch dimensions from single-threaded loader data footprint\n",
    "            if xb.dim() == 4 and xb.shape[0] == 1:\n",
    "                xb = xb.squeeze(0)   # Reshapes to [Time_Steps, Cluster_Nodes, Features]\n",
    "                vyb = vyb.squeeze(0)  # Reshapes to [Cluster_Nodes]\n",
    "                \n",
    "            xb = xb.to(device, non_blocking=True)\n",
    "            vyb = vyb.to(device, non_blocking=True)\n",
    "            \n",
    "            # Execute decentralized neighborhood forward trajectory integration pass\n",
    "            predictions = model(\n",
    "                global_sequence_x=xb, \n",
    "                cluster_data_registry=cluster_registry, \n",
    "                cluster_id=c_idx,\n",
    "                target_horizon_steps=xb.shape[0]\n",
    "            )\n",
    "            \n",
    "            # Align predictions with ground-truth targets at the final timestep horizon\n",
    "            target_snapshot = vyb.unsqueeze(-1)\n",
    "            \n",
    "            loss = criterion(predictions, target_snapshot)\n",
    "            total_loss += loss.item()\n",
    "            steps_tracked += 1\n",
    "            \n",
    "            # Evaluates first 15 blocks to establish an immediate performance baseline\n",
    "            \n",
    "            \n",
    "    return total_loss / steps_tracked\n",
    "\n",
    "# Execute the master tracking wrapper pass\n",
    "start_time = time.time()\n",
    "avg_mse_loss = execute_production_validation_sweep(production_model, val_loader, cluster_data)\n",
    "\n",
    "print(\"\\n\" + \"=\"*80)\n",
    "print(f\"🏁 RUN COMPLETION CONFIRMED\")\n",
    "print(\"=\"*80)\n",
    "print(f\"  ▪️ Baseline Integration MSE : {avg_mse_loss:.6f}\")\n",
    "print(f\"  ▪️ Pipeline Latency Duration: {time.time()-start_time:.2f} seconds\")\n",
    "print(\"=\"*80)"
   ]
  },
