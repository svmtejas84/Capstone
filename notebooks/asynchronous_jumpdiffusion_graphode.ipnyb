   "source": [
    "# ==============================================================================\n",
    "# CELL 9: GEOGRAPHIC SPATIAL ADVECTION PLUME VISUALIZATION Field\n",
    "# ==============================================================================\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy.interpolate import griddata\n",
    "\n",
    "print(\"[INIT] Rendering trained Jump-Diffusion spatial projection field...\")\n",
    "\n",
    "# 1. Pull a high-value real validation sample block from the loader\n",
    "production_model.eval()\n",
    "val_iter = iter(val_loader)\n",
    "xb_sample, vyb_sample, c_idx_sample, _ = next(val_iter)\n",
    "target_cid = int(c_idx_sample[0].item())\n",
    "\n",
    "# Standardize shapes to single-threaded footprint dimensions\n",
    "if xb_sample.dim() == 4 and xb_sample.shape[0] == 1:\n",
    "    xb_sample = xb_sample.squeeze(0)\n",
    "    vyb_sample = vyb_sample.squeeze(0)\n",
    "\n",
    "xb_device = xb_sample.to(device)\n",
    "\n",
    "with torch.no_grad():\n",
    "    # Forward pass across the optimized jump-diffusion network topology\n",
    "    predictions_scaled = production_model(\n",
    "        global_sequence_x=xb_device,\n",
    "        cluster_data_registry=cluster_data,\n",
    "        cluster_id=target_cid,\n",
    "        target_horizon_steps=xb_device.shape[0]\n",
    "    ).view(-1)\n",
    "\n",
    "# Rescale the continuous prediction surface back into real-world units (ug/m3)\n",
    "preds_real_space = np.clip((predictions_scaled * TARGET_SCALE).cpu().numpy(), a_min=0.0, a_max=None)\n",
    "\n",
    "# Isolate corresponding geographic UTM coordinates for this specific neighborhood sector\n",
    "part_obj = cluster_data[target_cid]\n",
    "cluster_global_node_ids = part_obj.n_id.cpu().numpy()\n",
    "x_coords = coords_np[cluster_global_node_ids, 0]\n",
    "y_coords = coords_np[cluster_global_node_ids, 1]\n",
    "\n",
    "# 2. Construct a continuous 2D triangulation canvas mesh\n",
    "resolution_points = 500\n",
    "grid_x, grid_y = np.mgrid[\n",
    "    x_coords.min():x_coords.max():complex(resolution_points),\n",
    "    y_coords.min():y_coords.max():complex(resolution_points)\n",
    "]\n",
    "\n",
    "grid_z = griddata(\n",
    "    points=np.stack([x_coords, y_coords], axis=1),\n",
    "    values=preds_real_space,\n",
    "    xi=(grid_x, grid_y),\n",
    "    method='linear'\n",
    ")\n",
    "\n",
    "# 3. Render High-DPI Scientific Plot\n",
    "fig, ax = plt.subplots(figsize=(10, 8), dpi=150)\n",
    "plt.style.use('default')\n",
    "plt.rcParams['font.family'] = 'serif'\n",
    "\n",
    "contour_plot = ax.contourf(\n",
    "    grid_x, grid_y, grid_z, \n",
    "    levels=100, \n",
    "    cmap='turbo', \n",
    "    extend='max'\n",
    ")\n",
    "\n",
    "# Overlay a micro-thin, highly translucent topology layer showing the road framework points\n",
    "ax.scatter(x_coords, y_coords, c='white', alpha=0.04, s=0.6)\n",
    "\n",
    "# Format a clean, elegant colorbar layout matching standard journal publications\n",
    "cbar = fig.colorbar(contour_plot, ax=ax, fraction=0.046, pad=0.04)\n",
    "cbar.set_label(r'Estimated Ambient $\\text{PM}_{2.5}$ Concentration ($\\mu\\text{g/m}^3$)', fontsize=11, labelpad=12)\n",
    "\n",
    "# Formal Academic Heading Framework\n",
    "ax.set_title(f\"Jump-Diffusion Graph Neural ODE Pred Surface: Airshed Sector (Cluster {target_cid})\", fontsize=12, fontweight='bold', pad=14)\n",
    "ax.set_xlabel(\"UTM Coordinate Easting (m)\", fontsize=10, labelpad=8)\n",
    "ax.set_ylabel(\"UTM Coordinate Northing (m)\", fontsize=10, labelpad=8)\n",
    "\n",
    "ax.ticklabel_format(style='sci', axis='both', scilimits=(0,0))\n",
    "ax.grid(True, linestyle=':', alpha=0.3, color='gray')\n",
    "plt.tight_layout()\n",
    "\n",
    "# Save direct vector-aligned PNG ready for document compilation\n",
    "output_fig_path = f\"jump_diffusion_spatial_plume_cluster_{target_cid}.png\"\n",
    "plt.savefig(output_fig_path, bbox_inches='tight', dpi=300)\n",
    "plt.show()\n",
    "\n",
    "print(f\"✅ Formal plot visualization rendered and saved cleanly to: '{output_fig_path}'\")"
   ]
