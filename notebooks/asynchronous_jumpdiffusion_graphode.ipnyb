   ],
   "source": [
    "# ==============================================================================\n",
    "# REPAIRED CELL 6: DECOUPLED FORWARD GRAPH INTERFACE\n",
    "# ==============================================================================\n",
    "\n",
    "class GlobalCitywideJumpDiffusionNetwork(nn.Module):\n",
    "    def __init__(self, input_dim, hidden_dim, output_dim, num_clusters=64):\n",
    "        super().__init__()\n",
    "        self.num_clusters = num_clusters\n",
    "        self.hidden_dim = hidden_dim\n",
    "        self.encoder = nn.Linear(input_dim, hidden_dim)\n",
    "        self.decoder = nn.Linear(hidden_dim, output_dim)\n",
    "        self.cluster_modules = nn.ModuleList([\n",
    "            AsynchronousGraphJumpODE(hidden_dim=hidden_dim, feature_dim=input_dim)\n",
    "            for _ in range(num_clusters)\n",
    "        ])\n",
    "        \n",
    "    def forward(self, global_sequence_x, cluster_data_registry, cluster_id, target_horizon_steps=12):\n",
    "        \"\"\"\n",
    "        Processes a single batch block, completely isolated to the targeted cluster_id.\n",
    "        \"\"\"\n",
    "        part = cluster_data_registry[cluster_id]\n",
    "        evaluation_timestamps = [float(step) for step in range(target_horizon_steps)]\n",
    "        \n",
    "        # global_sequence_x contains only this cluster's nodes via the inline dataset extraction\n",
    "        cluster_timeline = extract_asynchronous_cluster_timelines(global_sequence_x, threshold_sigma=1.5)\n",
    "        \n",
    "        h_init_cluster = self.encoder(global_sequence_x[0])\n",
    "        local_edge_index = part.edge_index.to(global_sequence_x.device)\n",
    "        \n",
    "        cluster_final_hidden = self.cluster_modules[cluster_id](\n",
    "            h_init=h_init_cluster, \n",
    "            edge_index=local_edge_index,\n",
    "            event_timeline=cluster_timeline, \n",
    "            evaluation_timestamps=evaluation_timestamps\n",
    "        )\n",
    "        \n",
    "        return self.decoder(cluster_final_hidden)\n",
    "\n",
    "# Allocate fresh model parameters on a clean GPU environment\n",
    "production_model = GlobalCitywideJumpDiffusionNetwork(input_dim=16, hidden_dim=HIDDEN_DIM, output_dim=1, num_clusters=64).to(device)\n",
    "print(\"[INIT] Repaired network initialized on clean GPU target context.\")"
   ]
  },
  {
