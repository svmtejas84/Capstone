   "source": [
    "# ==============================================================================\n",
    "# CELL 8: MULTI-EPOCH JUMP-DIFFUSION TRAINING ENGINE\n",
    "# ==============================================================================\n",
    "#rung kutta 4th order solver\n",
    "\n",
    "print(\"[INIT] Compiling production training loop machinery...\")\n",
    "\n",
    "# 1. Hyperparameter Bounds Configuration\n",
    "NUM_EPOCHS = 5\n",
    "learning_rate = 1e-3\n",
    "\n",
    "# Setup regularized optimizer core\n",
    "optimizer = optimizer_lib.AdamW(production_model.parameters(), lr=learning_rate, weight_decay=1e-3)\n",
    "criterion = nn.MSELoss()\n",
    "\n",
    "print(f\"[START] Beginning backpropagation sequence for {NUM_EPOCHS} optimization epochs.\")\n",
    "\n",
    "for epoch in range(1, NUM_EPOCHS + 1):\n",
    "    production_model.train()\n",
    "    epoch_loss = 0.0\n",
    "    steps_optimized = 0\n",
    "    \n",
    "    # We utilize a diagnostic batch slice to optimize weights cleanly per epoch block\n",
    "    epoch_bar = tqdm(val_loader, desc=f\"Epoch {epoch}/{NUM_EPOCHS}\")\n",
    "    \n",
    "    for xb, vyb, c_idx_t, _ in epoch_bar:\n",
    "        c_idx = int(c_idx_t[0].item())\n",
    "        \n",
    "        if xb.dim() == 4 and xb.shape[0] == 1:\n",
    "            xb = xb.squeeze(0)\n",
    "            vyb = vyb.squeeze(0)\n",
    "            \n",
    "        xb = xb.to(device, non_blocking=True)\n",
    "        vyb = vyb.to(device, non_blocking=True)\n",
    "        \n",
    "        # Clear gradient tracking buffers completely\n",
    "        optimizer.zero_grad(set_to_none=True)\n",
    "        \n",
    "        # Calculate forward path continuous-discrete representations\n",
    "        predictions = production_model(\n",
    "            global_sequence_x=xb,\n",
    "            cluster_data_registry=cluster_data,\n",
    "            cluster_id=c_idx,\n",
    "            target_horizon_steps=xb.shape[0]\n",
    "        )\n",
    "        \n",
    "        target_snapshot = vyb.unsqueeze(-1)\n",
    "        loss = criterion(predictions, target_snapshot)\n",
    "        \n",
    "        # Execute memory-efficient continuous backpropagation\n",
    "        loss.backward()\n",
    "        \n",
    "        # Prevent gradient explosions across dense integration step limits\n",
    "        torch.nn.utils.clip_grad_norm_(production_model.parameters(), max_norm=1.0)\n",
    "        \n",
    "        optimizer.step()\n",
    "        \n",
    "        epoch_loss += loss.item()\n",
    "        steps_tracked = steps_optimized + 1\n",
    "        steps_optimized += 1\n",
    "        \n",
    "        if steps_optimized % 10 == 0:\n",
    "            epoch_bar.set_postfix({\"Batch_Loss\": f\"{loss.item():.2f}\", \"Avg_Loss\": f\"{epoch_loss/steps_optimized:.2f}\"})\n",
    "            \n",
    "        \n",
    "    print(f\"🌟 [EPOCH {epoch:02d}/{NUM_EPOCHS:02d}] Mean Optimization Loss: {epoch_loss/steps_optimized:.4f}\")\n",
    "\n",
    "print(\"\\n\" + \"=\"*80)\n",
    "print(\"🏆 TRAINING PARADIGM EXECUTED SUCCESSFULLY\")\n",
    "print(\"=\"*80)"
   ]
  },
