   ],
   "source": [
    "# ==============================================================================\n",
    "# REPAIRED CELL 4: LOSS-ALIGNED LOADERS SETUP\n",
    "# ==============================================================================\n",
    "\n",
    "print(\"[DATA] Generating temporal validation loaders...\")\n",
    "df_raw = pd.read_parquet(ROOT_DIR / \"data/processed/model_input/model_input_node_hourly_features.parquet\")\n",
    "\n",
    "if \"node_index\" not in df_raw.columns:\n",
    "    node_map = pd.read_parquet(ROOT_DIR / \"data/processed/graph/topology_nodeid_to_index_map.parquet\")\n",
    "    node_to_idx = dict(zip(node_map[\"node_id\"].values, node_map[\"node_index\"].values))\n",
    "    df_raw[\"node_index\"] = df_raw[\"node_id\"].map(node_to_idx)\n",
    "\n",
    "all_times = pd.Index(sorted(df_raw[\"timestamp\"].unique()))\n",
    "T_total = len(all_times)\n",
    "time_codes = pd.Categorical(df_raw[\"timestamp\"], categories=all_times, ordered=True).codes.astype(np.int32)\n",
    "raw_ts_indices = np.ascontiguousarray(time_codes)\n",
    "raw_node_indices = np.ascontiguousarray(df_raw[\"node_index\"].values.astype(np.int64))\n",
    "df_raw[\"target_scaled\"] = pd.to_numeric(df_raw[\"station_pm25\"], errors=\"coerce\").fillna(0.0).astype(np.float32) / TARGET_SCALE\n",
    "raw_targets = np.ascontiguousarray(df_raw[\"target_scaled\"].values)\n",
    "\n",
    "sort_order = np.lexsort((raw_node_indices, raw_ts_indices))\n",
    "raw_ts_indices = raw_ts_indices[sort_order]\n",
    "raw_node_indices = raw_node_indices[sort_order]\n",
    "raw_targets = raw_targets[sort_order]\n",
    "time_breaks = np.searchsorted(raw_ts_indices, np.arange(T_total + 1, dtype=np.int32), side=\"left\")\n",
    "\n",
    "del df_raw\n",
    "gc.collect()\n",
    "\n",
    "class TierAwareClusterDatasetV3(Dataset):\n",
    "    def __init__(self, clusters, t0, t1, window=12, stride=24):\n",
    "        self.clusters = clusters\n",
    "        self.window = int(window)\n",
    "        self.starts = list(range(int(t0), min(int(t1), T_total) - self.window, int(stride)))\n",
    "        self.cluster_global = [np.asarray(c.n_id.cpu().numpy(), dtype=np.int64) for c in clusters]\n",
    "        self.samples = [(c_idx, t_start, \"station\") for c_idx in range(NUM_CLUSTERS) for t_start in self.starts]\n",
    "        \n",
    "    def __len__(self): \n",
    "        return len(self.samples)\n",
    "        \n",
    "    def __getitem__(self, idx):\n",
    "        c_idx, t0, mode = self.samples[idx]\n",
    "        part = self.clusters[c_idx]\n",
    "        n_ids = self.cluster_global[c_idx]\n",
    "        num_nodes = n_ids.shape[0]\n",
    "        x_win = np.zeros((self.window, num_nodes, 16), dtype=np.float32)\n",
    "        y_win = np.zeros((num_nodes,), dtype=np.float32)\n",
    "        \n",
    "        for w in range(self.window):\n",
    "            t_curr = t0 + w\n",
    "            for local_i, global_node_id in enumerate(n_ids.tolist()):\n",
    "                reg = part.global_feature_registry[global_node_id]\n",
    "                x_win[w, local_i, :] = reg[t_curr % reg.shape[0]].numpy()\n",
    "                \n",
    "            if w == self.window - 1:\n",
    "                t_target_safe = t_curr if t_curr < len(time_breaks) - 1 else (len(time_breaks) - 2)\n",
    "                s_ptr = time_breaks[t_target_safe]\n",
    "                e_ptr = time_breaks[t_target_safe + 1]\n",
    "                if e_ptr > s_ptr:\n",
    "                    t_nodes = raw_node_indices[s_ptr:e_ptr]\n",
    "                    t_vals = raw_targets[s_ptr:e_ptr]\n",
    "                    member = np.isin(t_nodes, n_ids, assume_unique=False)\n",
    "                    if np.any(member):\n",
    "                        g_sel = t_nodes[member]\n",
    "                        loc = np.searchsorted(n_ids, g_sel)\n",
    "                        ok = (loc >= 0) & (loc < num_nodes) & (n_ids[loc] == g_sel)\n",
    "                        if np.any(ok):\n",
    "                            y_win[loc[ok]] = t_vals[member][ok]\n",
    "                            \n",
    "        return torch.from_numpy(x_win), torch.from_numpy(y_win), c_idx, int(t0)\n",
    "\n",
    "val_ds = TierAwareClusterDatasetV3(cluster_data, t0=87178, t1=87514, window=12, stride=24)\n",
    "val_loader = DataLoader(val_ds, batch_size=1, shuffle=False, num_workers=0, pin_memory=False)\n",
    "print(\"✅ Loss-aligned loaders configured.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "44717877",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[COMPLETE] Jump-Diffusion core calculation modules compiled.\n"
     ]
    }
   ],
   "source": [
    "# ==============================================================================\n",
    "# CELL 5: CONTINUOUS DRIFT AND DISCRETE STOCHASTIC JUMP OPERATORS\n",
    "# ==============================================================================\n",
    "\n",
    "def extract_asynchronous_cluster_timelines(sequence_tensor, threshold_sigma=1.5):\n",
    "    \"\"\"\n",
    "    Tracks abrupt shifts across features using temporal gradients.\n",
    "    \"\"\"\n",
    "    time_steps, num_nodes, feature_dim = sequence_tensor.shape\n",
    "    event_timeline = {}\n",
    "    \n",
    "    # Check changes on Channel 1 (PM2.5)\n",
    "    temporal_gradients = torch.abs(sequence_tensor[1:, :, 1] - sequence_tensor[:-1, :, 1]) \n",
    "    shock_threshold = torch.mean(temporal_gradients) + (threshold_sigma * torch.std(temporal_gradients))\n",
    "    \n",
    "    for t in range(1, time_steps):\n",
    "        current_gradient_slice = torch.abs(sequence_tensor[t, :, 1] - sequence_tensor[t-1, :, 1])\n",
    "        affected_node_mask = current_gradient_slice >= shock_threshold\n",
    "        \n",
    "        if affected_node_mask.any():\n",
    "            event_timeline[float(t)] = {\n",
    "                \"node_mask\": affected_node_mask,\n",
    "                \"features\": sequence_tensor[t]\n",
    "            }\n",
    "    return event_timeline\n",
    "\n",
    "class HydrologicalAdvectionODEFunc(nn.Module):\n",
    "    def __init__(self, hidden_dim):\n",
    "        super().__init__()\n",
    "        self.spatial_conv = GCNConv(hidden_dim, hidden_dim)\n",
    "        self.act = nn.ELU()\n",
    "        self.active_edge_index = None\n",
    "\n",
    "    def set_topological_context(self, edge_index):\n",
    "        self.active_edge_index = edge_index\n",
    "\n",
    "    def forward(self, t, h):\n",
    "        dh_dt = self.spatial_conv(h, self.active_edge_index)\n",
    "        return self.act(dh_dt)\n",
    "\n",
    "class NeuralJumpOperator(nn.Module):\n",
    "    def __init__(self, hidden_dim, feature_dim):\n",
    "        super().__init__()\n",
    "        self.jump_gate = nn.Sequential(\n",
    "            nn.Linear(hidden_dim + feature_dim, hidden_dim * 2),\n",
    "            nn.ReLU(),\n",
    "            nn.Linear(hidden_dim * 2, hidden_dim)\n",
    "        )\n",
    "        \n",
    "    def forward(self, h_current, event_features, affected_node_mask):\n",
    "        merged_context = torch.cat([h_current, event_features], dim=-1)\n",
    "        delta_h = self.jump_gate(merged_context)\n",
    "        h_jumped = h_current.clone()\n",
    "        h_jumped[affected_node_mask] += delta_h[affected_node_mask]\n",
    "        return h_jumped\n",
    "\n",
    "class AsynchronousGraphJumpODE(nn.Module):\n",
    "    def __init__(self, hidden_dim, feature_dim):\n",
    "        super().__init__()\n",
    "        self.drift_ode = HydrologicalAdvectionODEFunc(hidden_dim)\n",
    "        self.jump_operator = NeuralJumpOperator(hidden_dim, feature_dim)\n",
    "        \n",
    "    def forward(self, h_init, edge_index, event_timeline, evaluation_timestamps):\n",
    "        self.drift_ode.set_topological_context(edge_index)\n",
    "        current_time = torch.tensor(0.0, device=h_init.device)\n",
    "        h_state = h_init.clone()\n",
    "        \n",
    "        for next_event_time in sorted(event_timeline.keys()):\n",
    "            event_t_tensor = torch.tensor(next_event_time, device=h_init.device)\n",
    "            \n",
    "            if next_event_time > current_time.item():\n",
    "                t_span = torch.stack([current_time, event_t_tensor])\n",
    "                h_integrated = odeint(self.drift_ode, h_state, t_span, method='rk4', options={'step_size': 0.2})\n",
    "                h_state = h_integrated[-1]\n",
    "            \n",
    "            event_data = event_timeline[next_event_time]\n",
    "            h_state = self.jump_operator(h_state, event_data[\"features\"], event_data[\"node_mask\"])\n",
    "            current_time = event_t_tensor\n",
    "            \n",
    "        final_horizon_t = torch.tensor(evaluation_timestamps[-1], device=h_init.device)\n",
    "        if final_horizon_t > current_time:\n",
    "            t_span = torch.stack([current_time, final_horizon_t])\n",
    "            h_final = odeint(self.drift_ode, h_state, t_span, method='rk4', options={'step_size': 0.2})\n",
    "            h_state = h_final[-1]\n",
    "            \n",
    "        return h_state\n",
    "\n",
    "print(\"[COMPLETE] Jump-Diffusion core calculation modules compiled.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "d0b9cdac",
